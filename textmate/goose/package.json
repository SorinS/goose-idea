{
  "name": "goose-language",
  "displayName": "Goose Language",
  "description": "The TextMate grammar, language configuration and snippets of the Goose VS Code extension (goose.git/vscode), read by the IntelliJ TextMate plugin.",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "contributes": {
    "languages": [{ "id": "goose", "aliases": ["Goose", "goose"], "extensions": [".goose"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "goose", "scopeName": "source.goose", "path": "./syntaxes/goose.tmLanguage.json" }],
    "snippets": [{ "language": "goose", "path": "./snippets/goose.json" }]
  }
}
